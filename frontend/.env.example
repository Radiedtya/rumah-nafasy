# Cloudflare Turnstile — hanya sitekey yang boleh ada di frontend
# Dapatkan dari https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# SECRET KEY **TIDAK BOLEH** di frontend — taruh di backend/.env
# TURNSTILE_SECRET_KEY=your_secret_key_here  ← backend only
